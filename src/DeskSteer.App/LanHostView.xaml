<UserControl x:Class="DeskSteer.App.LanHostView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="Share a view on your network" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Text="Select what to share, send the connection details privately, then approve the viewer. Viewing only; keyboard and mouse stay with you." Margin="0,12,0,14"/>
  <TextBlock Text="This computer's private IPv4 address"/><TextBox x:Name="AddressInput" Text="127.0.0.1" Margin="0,6,0,12"/>
  <TextBlock Text="Port"/><TextBox x:Name="PortInput" Text="47731" Margin="0,6,0,14"/>
  <CheckBox x:Name="ControlMode" Content="Share the primary display with optional keyboard and mouse control" Foreground="#EBEFF5" Margin="0,0,0,10"/>
  <TextBlock Text="Control mode shares your primary display instead of opening the picker. Viewing and control require separate approvals. Keyboard input acts on the foreground application on your computer." Margin="0,0,0,14"/>
  <WrapPanel><Button x:Name="StartButton" Content="Choose screen and start hosting" Click="StartClick" Margin="0,0,12,10"/><Button x:Name="StopButton" Content="Stop sharing" Click="StopClick" IsEnabled="False"/></WrapPanel>
  <TextBlock x:Name="HostStatus" Text="No network sharing is active." Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/>
  <Button x:Name="RevokeButton" Content="Revoke keyboard and mouse control" Click="RevokeClick" Visibility="Collapsed" Margin="0,12,0,0"/>
  <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,14,0,0">
   <TextBlock Text="Send these details privately. Verify the fingerprint with your viewer through a separate trusted channel."/>
   <TextBlock Text="Address and port" Margin="0,10,0,4"/><TextBox x:Name="EndpointText" IsReadOnly="True"/>
   <TextBlock Text="Fingerprint" Margin="0,10,0,4"/><TextBox x:Name="FingerprintText" IsReadOnly="True" TextWrapping="Wrap"/>
   <TextBlock Text="One-session pairing code" Margin="0,10,0,4"/><TextBox x:Name="PairingCodeText" IsReadOnly="True" TextWrapping="Wrap"/>
   <TextBlock x:Name="ExpiryText" Margin="0,10,0,0"/>
  </StackPanel>
 </StackPanel></Border>
</UserControl>
