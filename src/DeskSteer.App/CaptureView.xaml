<UserControl x:Class="DeskSteer.App.CaptureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Local screen preview" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="Choose a display or window in the Windows picker. The preview stays on this computer. Stop clears the image and releases capture resources." Foreground="#A6B4C7" Margin="0,12,0,18" LineHeight="24"/>
   <WrapPanel><Button x:Name="SelectButton" Content="Select display or window…" Click="SelectClick" Margin="0,0,12,10"/><Button x:Name="StopButton" Content="Stop capture" Click="StopClick" IsEnabled="False"/></WrapPanel>
   <TextBlock x:Name="CaptureStatus" Text="No capture is active." Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="Statistics" Foreground="#A6B4C7" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Background="#0D131B" BorderBrush="#303C4D" BorderThickness="1" CornerRadius="12" Padding="10" MinHeight="180">
   <Image x:Name="Preview" Stretch="Uniform" MaxHeight="460" AutomationProperties.Name="Local capture preview"/>
  </Border>
 </StackPanel>
</UserControl>
