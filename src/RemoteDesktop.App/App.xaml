<Application x:Class="RemoteDesktop.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#88D7C3"/>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EBEFF5"/><Setter Property="Background" Value="#131B25"/><Setter Property="BorderBrush" Value="#415169"/><Setter Property="CaretBrush" Value="#88D7C3"/><Setter Property="SelectionBrush" Value="#36594F"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#EBEFF5"/><Setter Property="Background" Value="#131B25"/><Setter Property="BorderBrush" Value="#415169"/><Setter Property="CaretBrush" Value="#88D7C3"/><Setter Property="SelectionBrush" Value="#36594F"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EBEFF5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EBEFF5"/><Setter Property="Background" Value="#293444"/><Setter Property="BorderBrush" Value="#415169"/><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3C4D60"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#88D7C3"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#48675F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1D2632"/><Setter Property="BorderBrush" Value="#303C4D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="26"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
 </Application.Resources>
</Application>
