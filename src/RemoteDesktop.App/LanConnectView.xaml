<UserControl x:Class="RemoteDesktop.App.LanConnectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="View a shared screen" FontSize="19" FontWeight="SemiBold"/>
   <StackPanel x:Name="ConnectionInputs">
    <TextBlock Text="Ask the host for connection details. Verify their fingerprint through a separate trusted channel before connecting. The host must approve your request." Margin="0,12,0,14"/>
    <TextBlock Text="Host address"/><TextBox x:Name="AddressInput" Text="127.0.0.1" Margin="0,6,0,12" AutomationProperties.Name="Host IPv4 address"/>
    <TextBlock Text="Port"/><TextBox x:Name="PortInput" Text="47731" Margin="0,6,0,12" AutomationProperties.Name="Host port"/>
    <TextBlock Text="Host fingerprint"/><TextBox x:Name="FingerprintInput" Margin="0,6,0,12" TextWrapping="Wrap" AutomationProperties.Name="Host certificate fingerprint"/>
    <TextBlock Text="Pairing code"/><PasswordBox x:Name="PairingCodeInput" Margin="0,6,0,12" AutomationProperties.Name="Temporary pairing code"/>
    <TextBlock Text="Your name for the host"/><TextBox x:Name="ViewerNameInput" Text="Viewer" MaxLength="64" Margin="0,6,0,14" AutomationProperties.Name="Your name shown to the host"/>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0"><Button x:Name="ConnectButton" Content="Request view" Click="ConnectClick" Margin="0,0,12,10"/><Button x:Name="DisconnectButton" Content="Disconnect / cancel" Click="DisconnectClick" IsEnabled="False"/></WrapPanel>
   <TextBlock x:Name="ConnectionStatus" Text="Disconnected." Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="ViewerStatistics" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Background="#0D131B" BorderBrush="#303C4D" BorderThickness="1" CornerRadius="12" Padding="10" MinHeight="180"><Image x:Name="Preview" Stretch="Uniform" MaxHeight="460" AutomationProperties.Name="Shared screen, viewing only"/></Border>
 </StackPanel>
</UserControl>

